# Copy this file to .env for local development. Never commit .env.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SAT_SCHEDULER_ENV=development
SAT_SCHEDULER_SESSION_SECRET=
SAT_SCHEDULER_HTTPS_ONLY=0
SAT_SCHEDULER_LOG_LEVEL=INFO

# sqlite (default)
SAT_SCHEDULER_DB_ENGINE=sqlite
SAT_SCHEDULER_DATABASE_PATH=./scheduler.db
SAT_SCHEDULER_SQLITE_BUSY_TIMEOUT_MS=30000

# PostgreSQL connection URL (Render and other managed PostgreSQL services)
# DATABASE_URL=postgresql://user:password@host:5432/sat_scheduler
# Alternatively, use the app-specific name:
# SAT_SCHEDULER_DATABASE_URL=postgresql://user:password@host:5432/sat_scheduler

# PostgreSQL split settings / Amazon RDS (uncomment and replace when used)
# SAT_SCHEDULER_DB_ENGINE=postgresql
# SAT_SCHEDULER_DB_HOST=database.example.internal
# SAT_SCHEDULER_DB_PORT=5432
# SAT_SCHEDULER_DB_NAME=sat_scheduler
# SAT_SCHEDULER_DB_USER=sat_scheduler
# Required by compose.yml; use a separate randomly generated value.
# SAT_SCHEDULER_DB_PASSWORD=
# SAT_SCHEDULER_DB_CONNECT_TIMEOUT=10
